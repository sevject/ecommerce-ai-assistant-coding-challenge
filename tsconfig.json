{
  // Minimal configuration so the starter runs under tsx and so editors resolve
  // ESM, `import.meta`, and `.ts` imports correctly.
  //
  // It intentionally does NOT enable `strict` or any style/lint rules. Choosing
  // and configuring type-strictness (and any test runner, linter, or formatter)
  // to your taste is part of the exercise — tighten this as you see fit.
  // Strictness is enabled: the assistant handles model-generated values and
  // SQLite rows, both of which arrive as `unknown`, and strict mode is what
  // forces those to be narrowed rather than assumed.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules"]
}
